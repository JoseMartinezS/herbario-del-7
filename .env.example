# URL pública del sitio, SIN slash final. Cambiar al conectar el dominio real.
NEXT_PUBLIC_SITE_URL=https://herbariodel7.com

# --- Catálogo en Supabase (opcional; F2.1) ---------------------------------
# SIN estas dos variables el sitio lee content/products.json (el modo
# original). CON las dos presentes lee la tabla `products` de Supabase y,
# si Supabase falla, cae automáticamente al JSON local (el sitio nunca se
# rompe por culpa de Supabase). Guía completa: supabase/README.md.
#
# Dónde conseguirlas: dashboard de Supabase → tu proyecto →
# Project Settings → API → copiá "Project URL" y la "Publishable key"
# (la clave pública/anon; NO uses la service_role: es un secreto).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
